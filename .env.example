VITE_CMS_API_URL=
VITE_SHOW_CMS_DEBUG=false
VITE_SITE_URL=https://sitevl.tech
# Необязательное переопределение. По умолчанию frontend использует same-origin /api/ai.
VITE_SITEVL_AI_ENDPOINT=/api/ai

# Configure these only in the server/Vercel environment. Never expose the key as VITE_*.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Server-only private Redis/Upstash REST storage for AI website leads and durable rate limits.
# Never prefix these variables with VITE_ and never commit real values.
# AI_LEADS_REDIS_REST_URL=
# AI_LEADS_REDIS_REST_TOKEN=
# AI_LEADS_RETENTION_DAYS=90
# Standard Vercel/Upstash pairs are also supported: UPSTASH_REDIS_REST_URL/TOKEN
# or KV_REST_API_URL/TOKEN. Configure only one complete pair.

# Optional server-only Telegram notifications through the existing SITEVL bot.
# Full concepts and credentials stay in private storage. Never use a VITE_ prefix.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# VISITOR_INTELLIGENCE_RETENTION_DAYS=180
# Optional future read-only owner API; the endpoint stays hidden while this is absent.
# VISITOR_OWNER_API_TOKEN=
# Optional, server-only: at least 32 random characters. Absent = IP assist disabled.
# Never use a VITE_ prefix. Set directly in Vercel Production, not in Git.
# VISITOR_IP_HASH_SECRET=
# Deal Radar PHASE 1: server-side only. Never use VITE_ for these values.
RADAR_ENABLED=false
RADAR_DEVELOPMENT_MODE=true
RADAR_ORIGIN=https://sitevl.tech
# RADAR_SUPABASE_URL=https://PROJECT_REF.supabase.co
# RADAR_SUPABASE_PUBLISHABLE_KEY=YOUR_PROJECT_PUBLISHABLE_OR_ANON_KEY
# Existing VISITOR_IP_HASH_SECRET may be reused instead. Minimum 32 random characters.
# RADAR_RATE_LIMIT_SECRET=GENERATE_LOCALLY_DO_NOT_COMMIT
# Phase 2 worker only, never needed by the browser or owner read API:
# RADAR_SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_DO_NOT_COMMIT
# Uses existing TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID and existing Upstash variables.
# No collectors, scheduler or Telegram delivery activated by these placeholders.
